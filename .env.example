# Copy file này thành .env rồi điền thông tin. KHÔNG chia sẻ file .env cho ai.

# Discord
DISCORD_BOT_TOKEN=dan_bot_token_vao_day
DISCORD_USER_ID=123456789012345678
# ID các kênh bot sẽ trả lời, cách nhau bằng dấu phẩy (để trống = mọi kênh bot thấy, nhưng vẫn chỉ trả lời bạn)
# Kênh đặt tên theo chuyên mục tin (vd #the-thao, #kinh-doanh) sẽ tự lấy tin chuyên mục đó
DISCORD_CHANNEL_ID=

# Bản tin buổi sáng (chào ngày mới + tin nổi bật + tổng hợp thẻ Trello)
# Giờ gửi HH:MM theo TIMEZONE; để trống = tắt
MORNING_TIME=08:00
TIMEZONE=Asia/Ho_Chi_Minh
# Kênh nhận bản tin; để trống = kênh đầu tiên trong DISCORD_CHANNEL_ID (cả hai trống = gửi DM cho bạn)
MORNING_CHANNEL_ID=

# Thời tiết (Open-Meteo, không cần key): địa điểm mặc định cho câu hỏi và bản tin sáng
WEATHER_LOCATION=Hà Nội

# Trello
TRELLO_API_KEY=dan_api_key_vao_day
TRELLO_TOKEN=dan_token_vao_day
TRELLO_BOARD_ID=AbCd1234

# Ollama
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_HOST=http://localhost:11434
# Đặt false để tắt chế độ "suy nghĩ" cho trả lời nhanh hơn (bỏ trống nếu model báo lỗi)
OLLAMA_THINK=
